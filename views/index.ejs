        <div class="testimonial-card">
          <div class="quote-mark">“</div>
          <div>
            <div class="review-stars" aria-label="<%= featuredReview.rating %> out of 5 stars">
              <% for (let i = 1; i <= 5; i++) { %><span class="<%= i <= featuredReview.rating ? 'star-filled' : 'star-empty' %>">★</span><% } %>
            </div>
            <p><%= featuredReview.reviewText %></p>
            <span class="review-note review-author">— <%= featuredReview.customerName %></span>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="testimonial-grid testimonial-grid-single">
        <div class="testimonial-card"><div class="quote-mark">“</div><div><p>Patient reviews can be displayed here once verified reviews are provided by the clinic.</p><span class="review-note">Only genuine patient feedback should be published.</span></div></div>
      </div>
    <% } %>

    <div class="testimonial-actions">
      <% if (reviews && reviews.length > 0) { %>
        <a href="/reviews" class="btn btn-outline">View All Reviews →</a>
      <% } %>
      <button type="button" class="btn btn-primary" id="openReviewFormBtn">+ Add a Review</button>
    </div>

    <div class="review-form-card" id="reviewFormCard" hidden>
      <h3>Share Your Experience</h3>
      <p class="muted">Your review will be posted right away.</p>

      <div id="reviewFormError"></div>

      <form action="/reviews" method="POST" class="review-submit-form" id="reviewSubmitForm">
        <label>
          Your Name
          <input type="text" name="customerName" required maxlength="80" placeholder="e.g. Ayesha Khan" />
        </label>

        <label>
          Rating
          <select name="rating" required>
            <option value="5" selected>★★★★★ Excellent</option>
            <option value="4">★★★★ Good</option>
            <option value="3">★★★ Average</option>
            <option value="2">★★ Poor</option>
            <option value="1">★ Very Poor</option>
          </select>
        </label>

        <label>
          Your Review
          <textarea name="reviewText" required maxlength="600" rows="4" placeholder="Tell us about your visit..."></textarea>
        </label>

        <!-- Honeypot: hidden from real visitors, only bots tend to fill this in -->
        <div style="position:absolute;left:-9999px;" aria-hidden="true">
          <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <button type="submit" class="btn btn-primary">Submit Review</button>
      </form>
    </div>
  </div>
</section>

<script>
  (function () {
    var toggleBtn = document.getElementById('openReviewFormBtn');
    var card = document.getElementById('reviewFormCard');
    if (toggleBtn && card) {
      toggleBtn.addEventListener('click', function () {
        card.hidden = !card.hidden;
        if (!card.hidden) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }

    function showSiteToast(message, isError) {
      var toast = document.createElement('div');
      toast.className = 'site-toast' + (isError ? ' site-toast-error' : '');
      toast.textContent = message;
      document.body.appendChild(toast);
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { toast.classList.add('show'); });
      });
      setTimeout(function () {
        toast.classList.remove('show');
        setTimeout(function () { toast.remove(); }, 300);
      }, 2400);
    }

    var form = document.getElementById('reviewSubmitForm');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      var btn = form.querySelector('button[type="submit"]');
      var errorBox = document.getElementById('reviewFormError');
      errorBox.innerHTML = '';
      btn.disabled = true;
      btn.textContent = 'Submitting...';

      fetch('/reviews', {
        method: 'POST',
        body: new FormData(form),
        headers: { 'X-Requested-With': 'XMLHttpRequest', Accept: 'application/json' }
      })
        .then(function (response) {
          return response.json().catch(function () { return null; }).then(function (data) {
            return { ok: response.ok, data: data };
          });
        })
        .then(function (result) {
          btn.disabled = false;
          btn.textContent = 'Submit Review';

          if (!result.ok || !result.data || !result.data.success) {
            throw new Error((result.data && result.data.error) || 'Something went wrong. Please try again.');
          }

          showSiteToast('Review added!');
          form.reset();
          card.hidden = true;

          // Reflect the new review immediately as the featured one, no reload needed.
          var review = result.data.review;
          if (review) {
            var grid = document.querySelector('.testimonial-grid-single, .testimonial-grid');
            if (grid) {
              var stars = '';
              for (var i = 1; i <= 5; i++) stars += '<span class="' + (i <= review.rating ? 'star-filled' : 'star-empty') + '">★</span>';
              grid.innerHTML =
                '<div class="testimonial-card"><div class="quote-mark">\u201c</div><div>' +
                '<div class="review-stars">' + stars + '</div>' +
                '<p></p><span class="review-note review-author">— </span></div></div>';
              grid.querySelector('p').textContent = review.reviewText;
              grid.querySelector('.review-author').append(review.customerName);
            }
            var viewAllLink = document.querySelector('.testimonial-actions a[href="/reviews"]');
            if (!viewAllLink) {
              var actions = document.querySelector('.testimonial-actions');
              var a = document.createElement('a');
              a.href = '/reviews';
              a.className = 'btn btn-outline';
              a.textContent = 'View All Reviews →';
              actions.insertBefore(a, actions.firstChild);
            }
          }
        })
        .catch(function (err) {
          errorBox.innerHTML = '<div class="alert alert-error">' + (err.message || 'Something went wrong. Please try again.') + '</div>';
          btn.disabled = false;
          btn.textContent = 'Submit Review';
        });
    });
  })();
</script>

