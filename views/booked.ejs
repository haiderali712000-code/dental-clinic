<%- include('partials/header') %>
<section class="container section narrow center"><div class="token-card"><span class="section-kicker">Appointment Request Received</span><h1>Thank you, <%= appointment.patientName %>!</h1><p>Your appointment token is:</p><div class="token-box"><%= appointment.token %></div><p class="muted">Save this token to check your appointment status later.</p><table class="summary-table"><tr><th>Service</th><td><%= appointment.service %></td></tr><tr><th>Total Price</th><td>Rs. <%= Number(appointment.servicePrice || 0).toLocaleString('en-PK') %></td></tr><tr><th>Preferred Date</th><td><%= appointment.preferredDate.toDateString() %></td></tr><tr><th>Status</th><td><span class="badge badge-pending"><%= appointment.status %></span></td></tr></table><div class="hero-actions center-actions"><a href="/status" class="btn btn-outline">Check Status</a><a href="/" class="btn btn-primary">Back to Home</a></div></div></section>
<%- include('partials/footer') %>
