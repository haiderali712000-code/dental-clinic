<%- include('../partials/admin-header') %>

<div class="page-header">
  <div>
    <h1>Customer Reviews</h1>
    <p class="muted">Reviews submitted on the website need approval here before they appear in the "What Our Customers Say" section. Reviews you add yourself below publish immediately.</p>
  </div>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card" style="margin-bottom:20px;">
  <h2 style="margin-top:0;">Add Review</h2>
  <form action="/admin/reviews" method="POST" class="review-add-form ajax-form" data-success-message="Review added!" data-redirect="/admin/reviews" data-reset="true">
    <label>Customer Name<input type="text" name="customerName" required placeholder="e.g. Ayesha Khan"></label>
    <label>Rating
      <select name="rating" required>
        <option value="5">★★★★★ (5)</option>
        <option value="4">★★★★☆ (4)</option>
        <option value="3">★★★☆☆ (3)</option>
        <option value="2">★★☆☆☆ (2)</option>
        <option value="1">★☆☆☆☆ (1)</option>
      </select>
    </label>
    <label class="review-text-field">Review Text<textarea name="reviewText" required rows="3" placeholder="What did the customer say about their visit?"></textarea></label>
    <button type="submit" class="btn btn-primary">Add Review</button>
  </form>
</div>

<h2 class="admin-section-title">Pending Approval<% if (pendingReviews.length) { %> (<%= pendingReviews.length %>)<% } %></h2>
<p class="muted">Reviews submitted by patients on the website. Approve to publish them, or delete to reject.</p>
<% if (pendingReviews.length === 0) { %>
  <div class="card empty-card">No reviews waiting for approval.</div>
<% } else { %>
  <div class="review-admin-list" style="margin-bottom:32px;">
    <% pendingReviews.forEach(function(review) { %>
      <div class="review-admin-row">
        <div style="flex:1;">
          <strong><%= review.customerName %></strong>
          <div class="review-stars" aria-label="<%= review.rating %> out of 5 stars">
            <% for (let i = 1; i <= 5; i++) { %><span class="<%= i <= review.rating ? 'star-filled' : 'star-empty' %>">★</span><% } %>
          </div>
          <p><%= review.reviewText %></p>
        </div>
        <form action="/admin/reviews/<%= review._id %>/approve" method="POST">
          <button type="submit" class="btn btn-primary">Approve</button>
        </form>
        <form action="/admin/reviews/<%= review._id %>/delete" method="POST" onsubmit="return confirm('Delete this review?');">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    <% }) %>
  </div>
<% } %>

<h2 class="admin-section-title">Published Reviews</h2>
<p class="muted">These are live on the site. Remove any you don't want shown, or unpublish to move it back to pending.</p>
<% if (approvedReviews.length === 0) { %>
  <div class="card empty-card">No published reviews yet.</div>
<% } else { %>
  <div class="review-admin-list">
    <% approvedReviews.forEach(function(review) { %>
      <div class="review-admin-row">
        <form action="/admin/reviews/<%= review._id %>" method="POST" class="review-edit-form ajax-form" data-success-message="Review updated!" data-redirect="/admin/reviews">
          <input type="text" name="customerName" value="<%= review.customerName %>" required aria-label="Customer name">
          <select name="rating" aria-label="Rating">
            <option value="5" <%= review.rating === 5 ? 'selected' : '' %>>★★★★★ (5)</option>
            <option value="4" <%= review.rating === 4 ? 'selected' : '' %>>★★★★☆ (4)</option>
            <option value="3" <%= review.rating === 3 ? 'selected' : '' %>>★★★☆☆ (3)</option>
            <option value="2" <%= review.rating === 2 ? 'selected' : '' %>>★★☆☆☆ (2)</option>
            <option value="1" <%= review.rating === 1 ? 'selected' : '' %>>★☆☆☆☆ (1)</option>
          </select>
          <textarea name="reviewText" rows="2" required aria-label="Review text"><%= review.reviewText %></textarea>
          <button type="submit" class="btn btn-primary">Save</button>
        </form>
        <form action="/admin/reviews/<%= review._id %>/unapprove" method="POST">
          <button type="submit" class="btn btn-outline">Unpublish</button>
        </form>
        <form action="/admin/reviews/<%= review._id %>/delete" method="POST" onsubmit="return confirm('Delete this review?');">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/admin-footer') %>
