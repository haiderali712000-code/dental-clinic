<%- include('../partials/admin-header') %>

<h1><%= member && member._id ? 'Edit Team Member' : 'Add Team Member' %></h1>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<form
  action="<%= member && member._id ? '/admin/team/' + member._id : '/admin/team' %>"
  method="POST"
  enctype="multipart/form-data"
  class="form-card"
>
  <label>
    Name *
    <input type="text" name="name" required value="<%= member ? member.name : '' %>" />
  </label>

  <label>
    Title *
    <input type="text" name="title" required value="<%= member ? member.title : '' %>" placeholder="e.g. Office Manager" />
  </label>

  <label>
    Photo
    <input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/gif" />
  </label>

  <% if (member && member.photoUrl) { %>
    <div style="margin: 10px 0 18px;">
      <p class="muted">Current Photo:</p>
      <img
        src="<%= member.photoUrl %>"
        alt="<%= member.name %>"
        style="width:120px;height:120px;object-fit:cover;border-radius:10px;"
      />
    </div>
  <% } %>

  <label>
    Description
    <textarea name="description" rows="4"><%= member ? member.description : '' %></textarea>
  </label>

  <label class="checkbox-label">
    <input type="checkbox" name="active" <%= !member || member.active ? 'checked' : '' %> />
    Active (visible on public website)
  </label>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary" id="teamSubmitBtn">Save Team Member</button>
    <a href="/admin/team" class="btn btn-outline">Cancel</a>
  </div>
</form>

<script>
  document.querySelector('.form-card').addEventListener('submit', function () {
    var btn = document.getElementById('teamSubmitBtn');
    if (btn.dataset.submitted) {
      // Already submitted once — block any further duplicate submits.
      return false;
    }
    btn.dataset.submitted = 'true';
    btn.disabled = true;
    btn.textContent = 'Saving...';
  });
</script>

<%- include('../partials/admin-footer') %>
