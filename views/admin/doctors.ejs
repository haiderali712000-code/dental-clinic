<%- include('../partials/admin-header') %>

<div class="page-header">
  <h1>Manage Doctors</h1>
  <a href="/admin/doctors/new" class="btn btn-primary">+ Add Doctor</a>
</div>

<% if (doctors.length === 0) { %>
  <p class="muted">No doctors added yet.</p>
<% } else { %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Photo</th>
        <th>Name</th>
        <th>Specialty</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% doctors.forEach(function(doc) { %>
        <tr>
          <td><img class="thumb" src="<%= doc.photoUrl || 'https://placehold.co/60x60?text=Dr' %>" alt="" /></td>
          <td><%= doc.name %></td>
          <td><%= doc.specialty %></td>
          <td>
            <% if (doc.active) { %>
              <span class="badge badge-confirmed">Active</span>
            <% } else { %>
              <span class="badge badge-cancelled">Inactive</span>
            <% } %>
          </td>
          <td class="actions">
            <a href="/admin/doctors/<%= doc._id %>/edit" class="btn btn-sm btn-outline">Edit</a>
            <form action="/admin/doctors/<%= doc._id %>/delete" method="POST" onsubmit="return confirm('Delete this doctor?');">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/admin-footer') %>
