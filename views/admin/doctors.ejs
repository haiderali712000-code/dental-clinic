<%- include('../partials/admin-header') %>

<div class="page-header">
  <h1>Manage Doctors</h1>
  <a href="/admin/doctors/new" class="btn btn-primary">+ Add Doctor</a>
</div>

<% if (doctors.length === 0) { %>
  <p class="muted">No doctors added yet.</p>
<% } else { %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Photo</th>
        <th>Name</th>
        <th>Specialty</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% doctors.forEach(function(doc) { %>
        <tr data-doctor-row="<%= doc._id %>">
          <td><img class="thumb" src="<%= doc.photoUrl || 'https://placehold.co/60x60?text=Dr' %>" alt="" /></td>
          <td><%= doc.name %></td>
          <td><%= doc.specialty %></td>
          <td>
            <% if (doc.active) { %>
              <span class="badge badge-confirmed">Active</span>
            <% } else { %>
              <span class="badge badge-cancelled">Inactive</span>
            <% } %>
          </td>
          <td class="actions">
            <a href="/admin/doctors/<%= doc._id %>/edit" class="btn btn-sm btn-outline">Edit</a>
            <form action="/admin/doctors/<%= doc._id %>/delete" method="POST" class="doctor-delete-form">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<script>
  document.querySelectorAll('.doctor-delete-form').forEach(function (form) {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (!confirm('Delete this doctor?')) return;

      const btn = form.querySelector('button');
      btn.disabled = true;
      btn.textContent = 'Deleting...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
        });
        let data = null;
        try { data = await response.json(); } catch (_) { /* not JSON */ }

        if (!response.ok || !data || !data.success) {
          throw new Error((data && data.error) || 'Request failed');
        }

        const row = form.closest('tr');
        row.remove();
      } catch (err) {
        alert('Could not delete this doctor. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Delete';
      }
    });
  });
</script>

<%- include('../partials/admin-footer') %>
