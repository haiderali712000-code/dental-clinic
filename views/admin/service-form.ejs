<%- include('../partials/admin-header') %>

<h1><%= service && service._id ? 'Edit Service' : 'Add Service' %></h1>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<form
  action="<%= service && service._id ? '/admin/services/' + service._id : '/admin/services' %>"
  method="POST"
  enctype="multipart/form-data"
  class="form-card ajax-form"
  data-success-message="<%= service && service._id ? 'Service updated!' : 'Service added!' %>"
  data-redirect="/admin/services"
>
  <label>
    Service Name *
    <input type="text" name="name" required value="<%= service ? service.name : '' %>" placeholder="e.g. Dental Filling" />
  </label>

  <label>
    Price (Rs.) *
    <input type="number" name="price" min="0" step="1" required value="<%= service ? service.price : '' %>" placeholder="5000" />
  </label>

  <label>
    Description
    <textarea name="description" rows="4" placeholder="Shown on this service's own page when a customer clicks it."><%= service ? service.description : '' %></textarea>
  </label>

  <label>
    Photo
    <input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/gif" />
  </label>
  <p class="muted" style="margin-top:-10px;">Shown in the icon box on the homepage grid and on this service's own page. If left blank, the default icon is used instead.</p>

  <% if (service && service.photoUrl) { %>
    <div style="margin: 10px 0 18px;">
      <p class="muted">Current Photo:</p>
      <img
        src="<%= service.photoUrl %>"
        alt="<%= service.name %>"
        style="width:120px;height:120px;object-fit:cover;border-radius:10px;"
      />
    </div>
  <% } %>

  <label>
    Video URL (optional)
    <input type="url" name="videoUrl" value="<%= service ? service.videoUrl : '' %>" placeholder="https://youtube.com/... or tiktok.com/..." />
  </label>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save Service</button>
    <a href="/admin/services" class="btn btn-outline">Cancel</a>
  </div>
</form>

<%- include('../partials/admin-footer') %>
