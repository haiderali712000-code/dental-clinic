<%- include('../partials/admin-header') %>

<div class="page-header">
  <h1>Appointments</h1>
  <form action="/admin/appointments" method="GET" class="filter-form">
    <select name="status" onchange="this.form.submit()">
      <option value="" <%= statusFilter === '' ? 'selected' : '' %>>All Statuses</option>
      <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pending</option>
      <option value="confirmed" <%= statusFilter === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
      <option value="completed" <%= statusFilter === 'completed' ? 'selected' : '' %>>Completed</option>
      <option value="cancelled" <%= statusFilter === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
    </select>
  </form>
</div>

<% if (appointments.length === 0) { %>
  <p class="muted">No appointments found.</p>
<% } else { %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Token</th>
        <th>Patient</th>
        <th>Phone</th>
        <th>Service</th>
        <th>Total Price</th>
        <th>Doctor</th>
        <th>Preferred Date</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% appointments.forEach(function(a) { %>
        <tr>
          <td><code><%= a.token %></code></td>
          <td><%= a.patientName %></td>
          <td><%= a.phone %></td>
          <td><%= a.service %></td>
          <td>Rs. <%= Number(a.servicePrice || 0).toLocaleString('en-PK') %></td>
          <td><%= a.doctor ? a.doctor.name : '—' %></td>
          <td><%= a.preferredDate.toDateString() %></td>
          <td><span class="badge badge-<%= a.status %>"><%= a.status %></span></td>
          <td class="actions">
            <form action="/admin/appointments/<%= a._id %>/status" method="POST" class="inline-form">
              <select name="status" onchange="this.form.submit()">
                <option value="pending" <%= a.status === 'pending' ? 'selected' : '' %>>Pending</option>
                <option value="confirmed" <%= a.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                <option value="completed" <%= a.status === 'completed' ? 'selected' : '' %>>Completed</option>
                <option value="cancelled" <%= a.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
              </select>
            </form>
            <form action="/admin/appointments/<%= a._id %>/delete" method="POST" onsubmit="return confirm('Delete this appointment?');">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/admin-footer') %>
