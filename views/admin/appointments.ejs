<%- include('../partials/admin-header') %>

<div class="page-header">
  <h1>Appointments</h1>
  <form action="/admin/appointments" method="GET" class="filter-form">
    <select name="status" onchange="this.form.submit()">
      <option value="" <%= statusFilter === '' ? 'selected' : '' %>>All Statuses</option>
      <option value="pending" <%= statusFilter === 'pending' ? 'selected' : '' %>>Pending</option>
      <option value="confirmed" <%= statusFilter === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
      <option value="completed" <%= statusFilter === 'completed' ? 'selected' : '' %>>Completed</option>
      <option value="cancelled" <%= statusFilter === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
    </select>
  </form>
</div>

<% if (appointments.length === 0) { %>
  <p class="muted">No appointments found.</p>
<% } else { %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Token</th><th>Patient</th><th>Phone</th><th>Service</th>
        <th>Total Price</th><th>Doctor</th><th>Preferred Date</th>
        <th>Status</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% appointments.forEach(function(a) { %>
        <tr>
          <td><code><%= a.token %></code></td>
          <td><%= a.patientName %></td>
          <td><%= a.phone %></td>
          <td><%= a.service %></td>
          <td>Rs. <%= Number(a.servicePrice || 0).toLocaleString('en-PK') %></td>
          <td><%= a.doctor ? a.doctor.name : '—' %></td>
          <td><%= a.preferredDate.toDateString() %></td>
          <td class="appointment-status">
            <span class="badge badge-<%= a.status %>"><%= a.status %></span>
          </td>
          <td class="actions">
            <form action="/admin/appointments/<%= a._id %>/status"
                  method="POST"
                  class="inline-form appointment-status-form"
                  data-token="<%= a.token %>">
              <select name="status" class="appointment-status-select">
                <option value="pending" <%= a.status === 'pending' ? 'selected' : '' %>>Pending</option>
                <option value="confirmed" <%= a.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                <option value="completed" <%= a.status === 'completed' ? 'selected' : '' %>>Completed</option>
                <option value="cancelled" <%= a.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
              </select>
            </form>

            <form action="/admin/appointments/<%= a._id %>/delete"
                  method="POST"
                  onsubmit="return confirm('Delete this appointment?');">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<div id="appointmentPopup" class="appointment-popup" aria-hidden="true">
  <div class="appointment-popup-box">
    <div class="appointment-popup-icon">✓</div>
    <h3 id="appointmentPopupTitle">Appointment Confirmed</h3>
    <p id="appointmentPopupMessage"></p>
    <button type="button" id="appointmentPopupClose" class="btn btn-sm">OK</button>
  </div>
</div>

<style>
.appointment-popup{display:none;position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,.45);align-items:center;justify-content:center;padding:20px}
.appointment-popup.show{display:flex}
.appointment-popup-box{width:min(420px,100%);background:#fff;border-radius:14px;padding:28px 24px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.2)}
.appointment-popup-icon{width:54px;height:54px;margin:0 auto 14px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:700;background:#e8f7ee;color:#18864b}
.appointment-popup-box h3{margin:0 0 8px}.appointment-popup-box p{margin:0 0 20px}
</style>

<script>
(function () {
  const forms = document.querySelectorAll('.appointment-status-form');
  const popup = document.getElementById('appointmentPopup');
  const title = document.getElementById('appointmentPopupTitle');
  const message = document.getElementById('appointmentPopupMessage');
  const close = document.getElementById('appointmentPopupClose');

  function showPopup(t, m) {
    title.textContent = t;
    message.textContent = m;
    popup.classList.add('show');
    popup.setAttribute('aria-hidden', 'false');
  }
  function hidePopup() {
    popup.classList.remove('show');
    popup.setAttribute('aria-hidden', 'true');
  }

  close.addEventListener('click', hidePopup);
  popup.addEventListener('click', e => { if (e.target === popup) hidePopup(); });

  forms.forEach(form => {
    const select = form.querySelector('.appointment-status-select');
    let previous = select.value;

    select.addEventListener('change', async () => {
      const newStatus = select.value;
      try {
        select.disabled = true;
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body: new URLSearchParams({ status: newStatus }).toString()
        });

        let data = null;
        try { data = await response.json(); } catch (_) { /* not JSON */ }

        if (!response.ok || !data || !data.success) {
          throw new Error((data && data.error) || 'Request failed');
        }

        previous = data.status;
        const row = form.closest('tr');
        const badge = row.querySelector('.appointment-status .badge');
        badge.textContent = data.status;
        badge.className = 'badge badge-' + data.status;

        if (data.status === 'confirmed') {
          showPopup('Appointment Confirmed',
            'Appointment ' + form.dataset.token + ' has been confirmed successfully.');
        } else {
          showPopup('Status Updated',
            'Appointment ' + form.dataset.token + ' is now ' +
            data.status.charAt(0).toUpperCase() + data.status.slice(1) + '.');
        }
      } catch (err) {
        select.value = previous;
        showPopup('Update Failed',
          'The appointment status could not be updated. Please try again.');
      } finally {
        select.disabled = false;
      }
    });
  });
})();
</script>

<%- include('../partials/admin-footer') %>
