<%- include('../partials/admin-header') %>

<h1>Dashboard</h1>
<p class="muted">Quick overview of today's clinic activity.</p>

<div class="grid stats-grid">
  <div class="card stat-card">
    <div class="stat-number"><%= todayCount %></div>
    <div class="stat-label">Today's Appointments</div>
  </div>
  <div class="card stat-card">
    <div class="stat-number"><%= pendingCount %></div>
    <div class="stat-label">Pending Appointments</div>
  </div>
  <div class="card stat-card">
    <div class="stat-number"><%= totalDoctors %></div>
    <div class="stat-label">Total Doctors</div>
  </div>
  <div class="card stat-card">
    <div class="stat-number"><%= totalAppointments %></div>
    <div class="stat-label">Total Appointments</div>
  </div>
</div>

<div class="quick-links">
  <a href="/admin/appointments" class="btn btn-primary">Manage Appointments</a>
  <a href="/admin/doctors" class="btn btn-outline">Manage Doctors</a>
</div>

<%- include('../partials/admin-footer') %>
