<%- include('../partials/admin-header') %>

<div class="page-header">
  <div>
    <h1>Ad Slider</h1>
    <p class="muted">Upload images for the moving offer/ad strip shown on the homepage between the offer banner and services section. They scroll continuously left to right and loop. Lower "Order" numbers appear first.</p>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<form action="/admin/ads" method="POST" enctype="multipart/form-data" class="form-card ajax-form" data-success-message="Ad image uploaded!" data-redirect="/admin/ads" data-reset="true">
  <label>
    Title <small>(optional, for your reference only)</small>
    <input type="text" name="title" placeholder="e.g. Winter Offer Banner" />
  </label>

  <label>
    Order <small>(optional, lower shows first)</small>
    <input type="number" name="order" value="0" />
  </label>

  <label>
    Ad Image *
    <input type="file" name="photo" required accept="image/jpeg,image/png,image/webp,image/gif" />
    <small class="form-help">JPG, PNG, WEBP or GIF. Maximum 5MB. The image is uploaded through the server to Cloudinary.</small>
  </label>

  <button type="submit" class="btn btn-primary">Upload Ad Image</button>
</form>

<h2 class="admin-section-title">Uploaded Ad Images</h2>
<% if (!ads.length) { %>
  <div class="card empty-card">No ad images uploaded yet.</div>
<% } else { %>
  <div class="admin-photo-grid">
    <% ads.forEach(function(ad) { %>
      <article class="admin-photo-card">
        <img src="<%= ad.imageUrl %>" alt="<%= ad.title || 'Ad image' %>" />
        <div class="admin-photo-meta">
          <strong><%= ad.title || 'Untitled' %></strong>
          <span>Order: <%= ad.order %></span>
          <form action="/admin/ads/<%= ad._id %>/delete" method="POST" onsubmit="return confirm('Delete this ad image?');">
            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
          </form>
        </div>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/admin-footer') %>
