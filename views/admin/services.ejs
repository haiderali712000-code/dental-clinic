<%- include('../partials/admin-header') %>

<div class="page-header">
  <div>
    <h1>Services</h1>
    <p class="muted">Add the dental services customers can select when booking. Set only the service name and price.</p>
  </div>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card" style="margin-bottom:20px;">
  <h2 style="margin-top:0;">Add Service</h2>
  <form action="/admin/services" method="POST" class="service-add-form">
    <label>Service Name<input type="text" name="name" required placeholder="e.g. Dental Filling"></label>
    <label>Price (Rs.)<input type="number" name="price" min="0" step="1" required placeholder="5000"></label>
    <button type="submit" class="btn btn-primary">Add Service</button>
  </form>
</div>

<h2 class="admin-section-title">Added Services</h2>
<% if (services.length === 0) { %>
  <div class="card empty-card">No services added yet.</div>
<% } else { %>
  <div class="service-admin-list">
    <% services.forEach(function(service) { %>
      <div class="service-admin-row">
        <form action="/admin/services/<%= service._id %>" method="POST" style="display:contents;">
          <input type="text" name="name" value="<%= service.name %>" required aria-label="Service name">
          <input type="number" name="price" value="<%= service.price %>" min="0" step="1" required aria-label="Service price">
          <button type="submit" class="btn btn-primary">Save</button>
        </form>
        <form action="/admin/services/<%= service._id %>/delete" method="POST" onsubmit="return confirm('Delete this service? Existing appointments will keep their saved service and price.');">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/admin-footer') %>
