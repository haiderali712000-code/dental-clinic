<%- include('../partials/admin-header') %>

<div class="page-header">
  <div>
    <h1>Services</h1>
    <p class="muted">Add the dental services customers can select when booking, with a description and photo shown on each service's own page.</p>
  </div>
  <a href="/admin/services/new" class="btn btn-primary">+ Add Service</a>
</div>

<% if (services.length === 0) { %>
  <p class="muted">No services added yet.</p>
<% } else { %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Photo</th>
        <th>Name</th>
        <th>Price</th>
        <th>Description</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% services.forEach(function(service) { %>
        <tr data-service-row="<%= service._id %>">
          <td><img class="thumb" src="<%= service.photoUrl || 'https://placehold.co/60x60?text=%F0%9F%A6%B7' %>" alt="" /></td>
          <td><%= service.name %></td>
          <td>Rs. <%= Number(service.price || 0).toLocaleString('en-PK') %></td>
          <td class="muted" style="max-width:280px;"><%= service.description ? (service.description.length > 80 ? service.description.slice(0, 80) + '…' : service.description) : '—' %></td>
          <td class="actions">
            <a href="/admin/services/<%= service._id %>/edit" class="btn btn-sm btn-outline">Edit</a>
            <form action="/admin/services/<%= service._id %>/delete" method="POST" class="service-delete-form">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<script>
  document.querySelectorAll('.service-delete-form').forEach(function (form) {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (!confirm('Delete this service? Existing appointments will keep their saved service and price.')) return;

      const btn = form.querySelector('button');
      btn.disabled = true;
      btn.textContent = 'Deleting...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
        });
        let data = null;
        try { data = await response.json(); } catch (_) { /* not JSON */ }

        if (!response.ok || !data || !data.success) {
          throw new Error((data && data.error) || 'Request failed');
        }

        form.closest('tr').remove();
        if (window.showAdminToast) window.showAdminToast('Service deleted.');
      } catch (err) {
        alert('Could not delete this service. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Delete';
      }
    });
  });
</script>

<%- include('../partials/admin-footer') %>
