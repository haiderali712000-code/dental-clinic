<%- include('../partials/admin-header') %>

<h1><%= doctor && doctor._id ? 'Edit Doctor' : 'Add Doctor' %></h1>

<% if (error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<form
  action="<%= doctor && doctor._id ? '/admin/doctors/' + doctor._id : '/admin/doctors' %>"
  method="POST"
  enctype="multipart/form-data"
  class="form-card"
>
  <label>
    Name *
    <input type="text" name="name" required value="<%= doctor ? doctor.name : '' %>" />
  </label>

  <label>
    Specialty *
    <input type="text" name="specialty" required value="<%= doctor ? doctor.specialty : '' %>" />
  </label>

  <label>
    Doctor Photo
    <input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/gif" />
  </label>

  <% if (doctor && doctor.photoUrl) { %>
    <div style="margin: 10px 0 18px;">
      <p class="muted">Current Photo:</p>
      <img
        src="<%= doctor.photoUrl %>"
        alt="<%= doctor.name %>"
        style="width:120px;height:120px;object-fit:cover;border-radius:10px;"
      />
    </div>
  <% } %>

  <label>
    Bio
    <textarea name="bio" rows="4"><%= doctor ? doctor.bio : '' %></textarea>
  </label>

  <label class="checkbox-label">
    <input type="checkbox" name="active" <%= !doctor || doctor.active ? 'checked' : '' %> />
    Active (visible on public website)
  </label>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary" id="doctorSubmitBtn">Save Doctor</button>
    <a href="/admin/doctors" class="btn btn-outline">Cancel</a>
  </div>
</form>

<script>
  document.querySelector('.form-card').addEventListener('submit', function () {
    var btn = document.getElementById('doctorSubmitBtn');
    if (btn.dataset.submitted) {
      // Already submitted once — block any further duplicate submits.
      return false;
    }
    btn.dataset.submitted = 'true';
    btn.disabled = true;
    btn.textContent = 'Saving...';
  });
</script>

<%- include('../partials/admin-footer') %>
